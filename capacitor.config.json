{
  "appId": "com.raqqa.app",
  "appName": "رقة",
  "webDir": "dist_web",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_name",
      "iconColor": "#FFC0CB"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "GoogleAuth": {
      "scopes": ["profile", "email", "openid"],
      "serverClientId": "162488255991-4tg6ubb9e23nah17ne5o69a47tt4e815.apps.googleusercontent.com"
    },
    "AdMob": {
      "initializeOnStartup": true
    },
    "LiveUpdate": {
      "readyTimeout": 10000,
      "autoDeleteBundles": true,
      "httpTimeout": 60000
    }
  },
  "android": {
    "allowMixedContent": true,
    "buildOptions": {
      "releaseType": "APK"
    }
  }
}
