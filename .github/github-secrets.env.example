# انسخ كل اسم كـ GitHub Secret مستقل من Settings > Secrets and variables > Actions
# لا ترفع هذا الملف بعد وضع القيم الحقيقية بداخله.

# =========================
# Android - Firebase
# =========================
FIREBASE_ANDROID_JSON_BASE64=<base64-of-android-app-google-services.json>

# =========================
# iOS - Firebase
# =========================
FIREBASE_IOS_PLIST_BASE64=<base64-of-GoogleService-Info.plist>

# =========================
# Android - Signing
# =========================
ANDROID_KEYSTORE_BASE64=<base64-of-raqqa-release.jks>
ANDROID_KEYSTORE_PASSWORD=<android-keystore-password>
ANDROID_KEY_ALIAS=<android-key-alias>
ANDROID_KEY_PASSWORD=<android-key-password>

# =========================
# Admin Android - Firebase
# =========================
FIREBASE_ADMIN_JSON_BASE64=<base64-of-admin-google-services.json>

# =========================
# Admin Android - Signing
# =========================
ADMIN_KEYSTORE_BASE64=<base64-of-admin-release.jks>
ADMIN_KEYSTORE_PASSWORD=<admin-keystore-password>
ADMIN_KEY_ALIAS=<admin-key-alias>
ADMIN_KEY_PASSWORD=<admin-key-password>

# GITHUB_TOKEN is provided automatically by GitHub Actions; do not create it manually.
